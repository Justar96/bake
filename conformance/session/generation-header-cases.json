{
  "schema": "bake/session-format-conformance/generation-header-cases",
  "version": 2,
  "history": [
    "Version 1: 95 cases.",
    "Version 2: 98 cases. Rust holds lone surrogates, so lone-surrogate-in-unexpected-member loses its json-parser limit, and three cases written from the TypeScript sources before either harness ran read a lone surrogate in a v0 id, a reversed pair in a v3 id beside a lone surrogate in cwd, and a lone surrogate in a newer generation's id, which the unsupported message quotes."
  ],
  "oracle": "JsonlSessionPersistence.stat(id) through readGenerationHeader in packages/session/session-persistence-jsonl/src/index.ts",
  "cases": [
    {
      "id": "v0-minimal",
      "sourceVersion": 0,
      "record": "{\"type\":\"session\",\"version\":0,\"id\":\"s1\",\"createdAt\":1700000000000,\"delegationDepth\":0}",
      "expect": {
        "outcome": "header",
        "header": {
          "version": 3,
          "id": "s1",
          "createdAt": 1700000000000,
          "isSeeded": false,
          "delegationDepth": 0
        }
      }
    },
