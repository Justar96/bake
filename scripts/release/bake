#!/bin/sh
set -eu
source=$0
while [ -L "$source" ]; do
  link=$(readlink "$source")
  case $link in
    /*) source=$link ;;
    *) source=$(dirname "$source")/$link ;;
  esac
done
root=$(CDPATH= cd -- "$(dirname -- "$source")/.." && pwd -P)
# BAKE_HOME selects the home; DSH_HOME, its earlier name, is read only when
# BAKE_HOME is unset. Both are exported with the result.
if [ -z "${BAKE_HOME+x}" ]; then
  if [ -n "${DSH_HOME+x}" ]; then BAKE_HOME=$DSH_HOME; else BAKE_HOME="$HOME/.bake"; fi
fi
DSH_HOME=$BAKE_HOME
export BAKE_HOME DSH_HOME
# Node writes the runtime watchdog's fatal-error reports and heap snapshots
# here, without environment variables or network interfaces. Node arguments,
# not NODE_OPTIONS, which the agent's subprocesses would inherit.
diagnostics=$BAKE_HOME/diagnostics
if [ -n "$BAKE_HOME" ]; then mkdir -p -m 700 -- "$diagnostics" 2>/dev/null || :; fi
case ${1-} in
  tui|headless|plugin|update|--profile) ;;
  *) set -- --profile tui "$@" ;;
esac
exec node --report-exclude-env --report-exclude-network "--diagnostic-dir=$diagnostics" "$root/apps/cli/lib/bin.js" "$@"
