new file mode 100644
index 0000000000000000000000000000000000000000..9bec8c5dcd0f4b06fac2967ff247908c29694f14
--- /dev/null
+++ b/build/text-cache.js
@@ -0,0 +1,37 @@
+// Bound process-global layout caches by both entry count and retained UTF-16
+// code units. Streaming creates distinct text on every frame, including text
+// much larger than the terminal's visible window.
+const MAX_ENTRIES = 1000;
+const MAX_CODE_UNITS = 1024 * 1024;
+export default class TextCache {
+    entries = new Map();
+    size = 0;
+    get(key) {
+        const entry = this.entries.get(key);
+        if (entry === undefined) {
+            return undefined;
+        }
+        this.entries.delete(key);
+        this.entries.set(key, entry);
+        return entry.value;
+    }
+    set(key, value) {
+        const size = key.length + (typeof value === 'string' ? value.length : 0);
+        const existing = this.entries.get(key);
+        if (existing !== undefined) {
+            this.size -= existing.size;
+            this.entries.delete(key);
+        }
+        // Oversized values still render; caching is optional.
+        if (size > MAX_CODE_UNITS) {
+            return;
+        }
+        while (this.entries.size >= MAX_ENTRIES || this.size + size > MAX_CODE_UNITS) {
+            const oldest = this.entries.keys().next().value;
+            this.size -= this.entries.get(oldest).size;
+            this.entries.delete(oldest);
+        }
+        this.entries.set(key, { value, size });
+        this.size += size;
+    }
+}
