diff --git a/build/styled-line.js b/build/styled-line.js
new file mode 100644
index 0000000000000000000000000000000000000000..1cb0569ec042206fff6674e140e77095ffa5b84f
--- /dev/null
+++ b/build/styled-line.js
@@ -0,0 +1,48 @@
+// Serialize Output rows without allocating per cell. ansi-tokenize's
+// styledCharsToString diffs every neighbouring pair of cells with fresh Sets
+// and arrays, so a resumed transcript's full-height frames churned gigabytes.
+import { ansiCodesToString, diffAnsiCodes } from '@alcalzone/ansi-tokenize';
+/** Output replaces cells and never mutates them, so every blank cell shares this one. */
+export const blankCell = {
+    type: 'char',
+    value: ' ',
+    fullWidth: false,
+    styles: [],
+};
+const sameStyles = (from, to) => {
+    if (from === to) {
+        return true;
+    }
+    if (from.length !== to.length) {
+        return false;
+    }
+    for (let index = 0; index < from.length; index++) {
+        if (from[index].code !== to[index].code || from[index].endCode !== to[index].endCode) {
+            return false;
+        }
+    }
+    return true;
+};
+/**
+ * The same string as ansi-tokenize's styledCharsToString: equal styles diff
+ * to no codes, so only style changes pay for a diff.
+ */
+export const styledCharsToString = (chars) => {
+    let ret = '';
+    for (let index = 0; index < chars.length; index++) {
+        const char = chars[index];
+        if (index === 0) {
+            if (char.styles.length > 0) {
+                ret += ansiCodesToString(char.styles);
+            }
+        }
+        else if (!sameStyles(chars[index - 1].styles, char.styles)) {
+            ret += ansiCodesToString(diffAnsiCodes(chars[index - 1].styles, char.styles));
+        }
+        ret += char.value;
+        if (index === chars.length - 1 && char.styles.length > 0) {
+            ret += ansiCodesToString(diffAnsiCodes(char.styles, []));
+        }
+    }
+    return ret;
+};
