CLAUDE.local.md
.env
node_modules/
lib/
*.tsbuildinfo
.cache/
.storages/
.sessions/
coverage/
.coverage-times.json
.doc-typecheck-*/
.node-next-types-*/
.oxlint-contract-*/
.oxlintrc.contract-*.json
oxlint-contract-*.ts
.humanize/
tmp/
.claude/commands/
.claude/launch.json
.claude/settings.json
.vscode/
.DS_Store
.idea
mise.toml
dist-exe/
/dist/
packages/**/__pycache__/
.artifacts/
distribution/host/public/
distribution/host/site/
distribution/host/.wrangler/
.dsh-build/
.playwright-mcp/
.orig
.worktrees/
worktrees/
.agents/worktrees/
.typert-*/
native/system/test/bin/

# tsc emit beside a source file when a command omits outDir. The build writes
# lib/, ignored above. A .js here is loaded instead of the .ts module.
*.js.map
*.d.ts.map
packages/**/src/**/*.js
apps/**/src/**/*.js
vendor/**/src/**/*.js
packages/**/src/**/*.d.ts
apps/**/src/**/*.d.ts
vendor/**/src/**/*.d.ts
!packages/**/src/**/ripgrep.d.ts
!packages/**/src/**/turndown-plugin-gfm.d.ts

# Profiles that instrumented Rust test children write beside their package
# when started without LLVM_PROFILE_FILE; `bun run coverage:rust` merges them.
rust/**/*.profraw

# A failing PTY run keeps its transcript here.
apps/tui/.smoke/

# bun run preflight logs
.preflight/
rust/target/

# cargo-fuzz (rust/fuzz): builds, crash artifacts, coverage, and the corpus
# runs grow. Only the `seed-*` inputs under corpus/ are committed.
rust/fuzz/target/
rust/fuzz/artifacts/
rust/fuzz/coverage/
rust/fuzz/generated/
rust/fuzz/corpus/*/*
!rust/fuzz/corpus/*/seed-*

# Symposium (rust/SYMPOSIUM.toml): `cargo agents sync` installs skill copies
# and project hooks for each configured agent beside the Cargo workspace.
rust/.agents/
rust/.claude/
rust/.codex/
rust/.gemini/
rust/.github/
rust/.goose/
rust/.kiro/
rust/.opencode/
