*.d.ts.map
packages/**/src/**/*.js
apps/**/src/**/*.js
vendor/**/src/**/*.js
packages/**/src/**/*.d.ts
apps/**/src/**/*.d.ts
vendor/**/src/**/*.d.ts
!packages/**/src/**/ripgrep.d.ts
!packages/**/src/**/turndown-plugin-gfm.d.ts

# A failing PTY run keeps its transcript here.
apps/tui/.smoke/

# bun run preflight logs
.preflight/
