{
  "schema": "bake/cli/session-inspect-expectations",
  "version": 1,
  "provenance": "Authored 2026-10-07 before the first run of `bake-rs session inspect`; no candidate output was copied in. Restored cases reuse the hand-written expectations of conformance/session/restore-cases.json (\"restore\", its `ts` entry, which those cases do not override) and conformance/session/zstd-cases.json (\"zstd\", its `rust` or `expected` entry), mapped to this command's record by tests/session_inspect.rs; they are not new independent predictions. A plain `torn` value is authored from the table's committed byte count and stored event count. Refusal kinds, seqs, lines, and offsets come from the cited table entry where it names them; message text and every diagnostic below are this command's own design. `fileBytes` of \"$input\" is the input's length.",
  "restored": [
    {"id": "plain-complete", "table": "restore", "case": "tool-call-turn", "name": "session.v3.jsonl", "maxBytes": 4533, "maxSourceSeqs": 64, "torn": null},
    {"id": "plain-interrupted-turn", "table": "restore", "case": "cut-after-step-start", "name": "session.v3.jsonl", "maxBytes": 620, "maxSourceSeqs": 64, "torn": null},
    {"id": "plain-torn", "table": "restore", "case": "torn-final-record", "name": "session.v3.jsonl", "maxBytes": 4533, "maxSourceSeqs": 64, "torn": {"truncateTo": 4435, "recoveredFrom": 15, "recoveredEventCount": 0}},
    {"id": "plain-seeded", "table": "restore", "case": "seeded-marker-last", "name": "session.v3.jsonl", "maxBytes": 4616, "maxSourceSeqs": 64, "torn": null},
    {"id": "plain-source-budget-exact", "table": "restore", "case": "packed-source-references", "name": "session.v3.jsonl", "maxBytes": 4537, "maxSourceSeqs": 2, "torn": null},
    {"id": "zstd-complete", "table": "zstd", "case": "single-batch", "name": "session.v3.jsonl.zstd", "maxBytes": 444, "maxSourceSeqs": 64},
    {"id": "zstd-recovered", "table": "zstd", "case": "torn-checksum", "name": "session.v3.jsonl.zstd", "maxBytes": 458, "maxSourceSeqs": 64},
    {"id": "zstd-production-complete", "table": "zstd", "case": "production-compressed-block", "name": "session.v3.jsonl.zstd", "maxBytes": 418, "maxSourceSeqs": 64},
    {"id": "zstd-production-recovered", "table": "zstd", "case": "production-compressed-torn-checksum", "name": "session.v3.jsonl.zstd", "maxBytes": 2097152, "maxSourceSeqs": 64}
  ],
  "refused": [
    {"id": "zstd-checksum", "table": "zstd", "case": "bad-checksum", "name": "session.v3.jsonl.zstd", "maxBytes": 444, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "zstd", "formatVersion": 3, "fileBytes": 444,
       "refusal": {"kind": "invalid", "message": "corrupt Zstandard session log: frame at byte 115 failed validation", "line": null, "seq": null, "offset": 115}}},
    {"id": "plain-named-zstd", "table": "restore", "case": "tool-call-turn", "name": "session.v3.jsonl.zstd", "maxBytes": 4533, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "zstd", "formatVersion": 3, "fileBytes": 4533,
       "refusal": {"kind": "invalid", "message": "corrupt Zstandard session log: invalid frame magic at byte 0", "line": null, "seq": null, "offset": 0}}},
    {"id": "zstd-named-plain", "table": "zstd", "case": "single-batch", "name": "session.v3.jsonl", "maxBytes": 444, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "none", "formatVersion": 3, "fileBytes": 444,
       "refusal": {"kind": "native-limit", "message": "this preview requires valid UTF-8 in the session header", "line": null, "seq": null, "offset": null}}},
    {"id": "zstd-without-lf-named-plain", "table": "zstd", "case": "production-compressed-block", "name": "session.v3.jsonl", "maxBytes": 319, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "none", "formatVersion": 3, "fileBytes": 319,
       "refusal": {"kind": "invalid", "message": "empty or header-less session log", "line": null, "seq": null, "offset": null}}},
    {"id": "zstd-plaintext-budget", "table": "zstd", "case": "production-compressed-block", "name": "session.v3.jsonl.zstd", "maxBytes": 417, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "zstd", "formatVersion": 3, "fileBytes": 319,
       "refusal": {"kind": "native-limit", "message": "decoded plaintext exceeds --max-bytes 417", "line": null, "seq": null, "offset": null}}},
    {"id": "plain-source-budget-exceeded", "table": "restore", "case": "packed-source-references", "name": "session.v3.jsonl", "maxBytes": 4537, "maxSourceSeqs": 1,
     "stdout": {"status": "refused", "encoding": "none", "formatVersion": 3, "fileBytes": 4537,
       "refusal": {"kind": "native-limit", "message": "an event's sourceEventSeqs expand past --max-source-seqs 1", "line": 11, "seq": null, "offset": null}}},
    {"id": "plain-newer-header", "table": "restore", "case": "tool-call-turn", "headerFind": "\"version\":3", "headerReplace": "\"version\":4", "name": "session.v3.jsonl", "maxBytes": 4533, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "none", "formatVersion": 3, "fileBytes": "$input",
       "refusal": {"kind": "unsupported", "message": "the header records a newer Session format than this preview's format 3", "line": null, "seq": null, "offset": null}}},
    {"id": "plain-older-header", "table": "restore", "case": "tool-call-turn", "headerFind": "\"version\":3", "headerReplace": "\"version\":2", "name": "session.v3.jsonl", "maxBytes": 4533, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "none", "formatVersion": 3, "fileBytes": "$input",
       "refusal": {"kind": "unsupported", "message": "the header records an older Session format than this preview's format 3", "line": null, "seq": null, "offset": null}}},
    {"id": "plain-unknown-required-type", "table": "restore", "case": "unknown-required-type", "name": "session.v3.jsonl", "maxBytes": 9755, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "none", "formatVersion": 3, "fileBytes": "$input",
       "refusal": {"kind": "unsupported", "message": "an event type unknown to this preview is not marked ignorable", "line": null, "seq": 7, "offset": null}}},
    {"id": "plain-stored-validation", "table": "restore", "case": "stored-tool-update-data", "name": "session.v3.jsonl", "maxBytes": 9755, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "none", "formatVersion": 3, "fileBytes": "$input",
       "refusal": {"kind": "invalid", "message": "a stored event failed validation (tool-update-data)", "line": null, "seq": 14, "offset": null}}},
    {"id": "plain-construction", "table": "restore", "case": "header-reason", "name": "session.v3.jsonl", "maxBytes": 9755, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "none", "formatVersion": 3, "fileBytes": "$input",
       "refusal": {"kind": "invalid", "message": "Session construction rejected an event (header-reason)", "line": null, "seq": 6, "offset": null}}},
    {"id": "plain-image-offload", "table": "restore", "case": "image-offload", "name": "session.v3.jsonl", "maxBytes": 9755, "maxSourceSeqs": 64,
     "stdout": {"status": "refused", "encoding": "none", "formatVersion": 3, "fileBytes": "$input",
       "refusal": {"kind": "native-limit", "message": "image/offload events are not restored by this preview", "line": null, "seq": 7, "offset": null}}}
  ],
  "escaping": {
    "log": "{\"type\":\"session\",\"version\":3,\"id\":\"\\\"q\\u0007\",\"createdAt\":1,\"cwd\":\"/w/ü\\u001b[31m\",\"isSeeded\":false,\"delegationDepth\":0}\n",
    "name": "session.v3.jsonl", "maxBytes": 4096, "maxSourceSeqs": 1,
    "stdout": "{\"status\":\"restored\",\"encoding\":\"none\",\"formatVersion\":3,\"fileBytes\":123,\"header\":{\"id\":\"\\\"q\\u0007\",\"createdAt\":1,\"cwd\":\"/w/ü\\u001b[31m\",\"parentSession\":null,\"isSeeded\":false,\"origin\":null,\"delegationDepth\":0,\"agentPreset\":null},\"storedEventCount\":0,\"committedPlaintextBytes\":123,\"inheritedEventCount\":0,\"torn\":null,\"repair\":{\"closerTypes\":[],\"endSeedAppended\":true},\"projection\":{\"messageCount\":0,\"hasRequestHeader\":false,\"hasRequestContext\":false}}\n"
  },
  "fileFailures": [
    {"id": "plain-over-max-bytes", "table": "restore", "case": "tool-call-turn", "name": "session.v3.jsonl", "maxBytes": 4532, "stderr": "bake-rs: {path} is 4533 bytes, over --max-bytes 4532\n"},
    {"id": "zstd-over-max-bytes", "table": "zstd", "case": "single-batch", "name": "session.v3.jsonl.zstd", "maxBytes": 443, "stderr": "bake-rs: {path} is 444 bytes, over --max-bytes 443\n"},
    {"id": "directory", "kind": "directory", "name": "session.v3.jsonl", "stderr": "bake-rs: {path} is not a regular file\n"},
    {"id": "fifo", "kind": "fifo", "name": "session.v3.jsonl", "stderr": "bake-rs: {path} is not a regular file\n"},
    {"id": "missing", "kind": "missing", "name": "session.v3.jsonl.zstd", "stderrPrefix": "bake-rs: cannot open {path}: "}
  ],
  "names": {
    "legacy": [
      ["session.jsonl", 0], ["session.v1.jsonl", 1], ["session.v2.jsonl.zstd", 2]
    ],
    "legacyStderr": "bake-rs: {path} is a format v{version} Session log; this preview reads only format 3 and does not migrate older logs\n",
    "newer": [
      ["session.v4.jsonl", 4], ["session.v9007199254740991.jsonl.zstd", 9007199254740991]
    ],
    "newerStderr": "bake-rs: {path} is a format v{version} Session log, newer than the format 3 this preview reads\n",
    "noncanonical": [
      "Session.v3.jsonl", "session.v03.jsonl", "session.v0.jsonl", "session.v.jsonl", "session.v3.JSONL",
      "session.v3.jsonl.zst", "session.v3.jsonl.tmp", "session.v3.jsonl.zstd.tmp", "session.v3.jsonl.zstd.zstd",
      "session.v9007199254740992.jsonl", "x.jsonl", "session.v3.json"
    ],
    "noncanonicalStderr": "bake-rs: {path} is not a canonical Session log name; expected session.v3.jsonl or session.v3.jsonl.zstd\n"
  },
  "usage": {
    "stderr": "bake-rs: {message}\n\nRun 'bake-rs session inspect --help' for usage.\n",
    "cases": [
      [["session"], "missing a command after 'session'"],
      [["session", "list"], "unknown command 'list' for 'session'"],
      [["session", "inspect"], "missing required option '--max-bytes'"],
      [["session", "inspect", "--max-bytes", "1", "f/session.v3.jsonl"], "missing required option '--max-source-seqs'"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "1"], "missing the Session log path"],
      [["session", "inspect", "--max-source-seqs", "1", "--max-bytes"], "option '--max-bytes' needs a value"],
      [["session", "inspect", "--max-bytes", "1", "--max-bytes", "2", "--max-source-seqs", "1", "f/session.v3.jsonl"], "option '--max-bytes' was given more than once"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "1", "--max-source-seqs", "1", "f/session.v3.jsonl"], "option '--max-source-seqs' was given more than once"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "1", "--max", "f/session.v3.jsonl"], "unknown option '--max' for 'session inspect'"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "1", "-x/session.v3.jsonl"], "unknown option '-x/session.v3.jsonl' for 'session inspect'"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "1", "a/session.v3.jsonl", "b/session.v3.jsonl"], "unexpected argument 'b/session.v3.jsonl' for 'session inspect'"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "1", "--", "a/session.v3.jsonl", "--"], "unexpected argument '--' for 'session inspect'"],
      [["session", "--help", "x"], "unexpected argument 'x' after '--help'"],
      [["session", "-h", "inspect"], "unexpected argument 'inspect' after '-h'"],
      [["session", "inspect", "--help", "--max-bytes"], "unexpected argument '--max-bytes' after '--help'"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "1", "--help"], "option '--help' must be the only operand of 'session inspect'"],
      [["session", "inspect", "--max-source-seqs", "1", "--max-bytes", "1\n", "f/session.v3.jsonl"], "option '--max-bytes' needs a positive decimal integer no greater than 9007199254740991, not '1\\n'"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "\u001b[31m", "f/session.v3.jsonl"], "option '--max-source-seqs' needs a positive decimal integer no greater than 9007199254740991, not '\\u{1b}[31m'"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "1", "--it's", "f/session.v3.jsonl"], "unknown option '--it\\'s' for 'session inspect'"],
      [["session", "inspect", "--max-bytes", "1", "--max-source-seqs", "1", "a/session.v3.jsonl", "b'\\c\nd"], "unexpected argument 'b\\'\\\\c\\nd' for 'session inspect'"],
      [["session", "ins\u0007pect"], "unknown command 'ins\\u{7}pect' for 'session'"]
    ],
    "badValues": ["0", "05", "+5", "-1", " 5", "5 ", "", "1e3", "0x10", "1_000", "9007199254740992", "18446744073709551616", "٥"],
    "badValueMessage": "option '{option}' needs a positive decimal integer no greater than 9007199254740991, not '{value}'",
    "nonUtf8Value": ["--max-bytes", "option '--max-bytes' needs a positive decimal integer no greater than 9007199254740991, not \"\\xFF\""],
    "largestValue": "9007199254740991"
  }
}
