{
  "name": "bake-cli",
  "description": "Bake CLI: profile launch, plugin management, and configuration inspection",
  "version": "0.3.8",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bake.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "bake": "lib/bin.js",
    "dsh": "lib/bin.js"
  },
  "files": [
    "lib/*.js",
    "lib/types/*.d.ts"
  ],
  "dsh": {
    "configTrees": [
      {
        "mount": "config/agent-presets",
        "path": "../../packages/preset/agent-presets/presets",
        "scanRoster": true
      }
    ]
  },
  "license": "MIT",
  "dependencies": {
    "bake-tui-app": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "bake-hmr": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "bake-agent-instructions": "workspace:^",
    "bake-agent-tool-presentation": "workspace:^",
    "bake-app-boot": "workspace:^",
    "bake-base": "workspace:^",
    "bake-cmdline": "workspace:^",
    "bake-command-compact": "workspace:^",
    "bake-command-goal": "workspace:^",
    "bake-compaction-basic": "workspace:^",
    "bake-compaction-tool-result-pruner": "workspace:^",
    "bake-desktop": "workspace:^",
    "bake-fs-local": "workspace:^",
    "bake-goal": "workspace:^",
    "bake-goal-round-driver": "workspace:^",
    "bake-headless": "workspace:^",
    "bake-home-paths": "workspace:^",
    "bake-hooks-claude-code": "workspace:^",
    "bake-hooks-codex": "workspace:^",
    "bake-host-webserver": "workspace:^",
    "bake-jobs-local": "workspace:^",
    "bake-launch-environment": "workspace:^",
    "bake-mcp-client": "workspace:^",
    "bake-persona": "workspace:^",
    "bake-pwsh-local": "workspace:^",
    "bake-pwsh-sandbox": "workspace:^",
    "bake-schedule": "workspace:^",
    "bake-session-projection": "workspace:^",
    "bake-session-reference": "workspace:^",
    "bake-skill": "workspace:^",
    "bake-skill-filesystem": "workspace:^",
    "bake-terminal": "workspace:^",
    "bake-terminal-bash": "workspace:^",
    "bake-token-meter": "workspace:^",
    "bake-tool-ask-user": "workspace:^",
    "bake-tool-bash": "workspace:^",
    "bake-tool-bash-persistent": "workspace:^",
    "bake-tool-cordis": "workspace:^",
    "bake-tool-fs": "workspace:^",
    "bake-tool-fs-search": "workspace:^",
    "bake-tool-goal": "workspace:^",
    "bake-tool-jobs": "workspace:^",
    "bake-tool-pwsh": "workspace:^",
    "bake-tool-pwsh-persistent": "workspace:^",
    "bake-tool-skill": "workspace:^",
    "bake-tool-subagent": "workspace:^",
    "bake-tool-subagent-control": "workspace:^",
    "bake-tool-web": "workspace:^",
    "bake-updater": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "commander": "catalog:",
    "js-yaml": "catalog:",
    "node-addon-require-builtin": "catalog:",
    "bake-http-proxy": "workspace:^",
    "bake-mcp-resources": "workspace:^",
    "bake-plugin-manager": "workspace:^",
    "bake-atomic-write": "workspace:^"
  },
  "devDependencies": {
    "bake-agent": "workspace:^",
    "bake-agent-loop": "workspace:^",
    "bake-agent-loop-testkit": "workspace:^",
    "bake-attachment-local": "workspace:^",
    "bake-bash-local": "workspace:^",
    "bake-credentials-local": "workspace:^",
    "bake-fs-observation-policy": "workspace:^",
    "bake-fs-sandbox": "workspace:^",
    "bake-llm": "workspace:^",
    "bake-llm-mock-server": "workspace:^",
    "bake-llm-pi-ai": "workspace:^",
    "bake-llm-replay": "workspace:^",
    "bake-loader-smoke": "workspace:^",
    "bake-sandbox-local": "workspace:^",
    "bake-sandbox-policy": "workspace:^",
    "bake-session": "workspace:^",
    "bake-session-checkpoint-policy": "workspace:^",
    "bake-session-persistence-jsonl": "workspace:^",
    "bake-session-query": "workspace:^",
    "bake-shell-env": "workspace:^",
    "bake-settings": "workspace:^",
    "bake-settings-file": "workspace:^",
    "bake-subagent": "workspace:^",
    "bake-subagent-spawn-in-process": "workspace:^",
    "bake-subprocess-local": "workspace:^",
    "bake-system-prompt": "workspace:^",
    "bake-tools": "workspace:^",
    "bake-user-approval": "workspace:^",
    "bake-tui-ui": "workspace:^",
    "@types/js-yaml": "catalog:",
    "@types/ws": "catalog:",
    "ajv": "catalog:",
    "execa": "catalog:",
    "ws": "catalog:"
  },
  "exports": {
    "./profile-boot": {
      "types": "./lib/types/profile-boot.d.ts",
      "default": "./lib/profile-boot.js"
    },
    "./lib/*": "./lib/*",
    "./package.json": "./package.json"
  }
}
