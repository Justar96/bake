    "script": "import assert from 'node:assert/strict'\nimport * as original from './original.mjs'\nimport * as candidate from './candidate.mjs'\nconst documents = Array.from({length: 2000}, (_, i) => 'Validate ordering, cancellation, and resource cleanup. '.repeat(12) + `\\nH${String(i).padStart(5,'0')}_END`)\nconst results = []\nfor (let round=0;round<3;round++) for (const name of round%2===0 ? ['original','candidate'] : ['candidate','original']) {\n const parser = name==='original' ? original : candidate\n global.gc(); const start=performance.now();let chars=0\n for (const source of documents) {\n   chars += parser.markdownLines(source).reduce((sum,line)=>sum+line.text.length,0)\n   chars += parser.finishedMarkdown(source)\n }\n results.push({round,name,ms:performance.now()-start,chars})\n}\nassert(results.every(r=>r.chars===results[0].chars))\nconsole.log(JSON.stringify({workload:{documents:documents.length,answerBytes:documents[0].length,operations:'markdownLines and finishedMarkdown'},results},null,2))\n",
    "build": "bun build apps/tui/packages/ui/src/markdown.ts --target=node --format=esm --outfile <variant>.mjs",
    "run": "node --expose-gc probe.mjs",
    "original": "per-call options and GFM descriptors at baseline",
    "candidate": "same options/descriptors hoisted to a module constant; tested and reverted"
  },
  "controlScript": "import pathlib,subprocess,json\nroot=pathlib.Path.cwd(); paths=[root/'packages/boot/plugin-manager/lib/index.js',root/'packages/boot/plugin-manager/lib/types/operations.js'];saved={p:p.read_text() for p in paths}\ntry:\n for iteration in range(3):\n  for variant in (['original','candidate'] if iteration%2==0 else ['candidate','original']):\n   for p,s in saved.items():\n    if variant=='original':\n     s='import { execa } from \"execa\";\\n'+s\n     s=s.replace('const { execa } = await import(\"execa\");','')\n    p.write_text(s)\n   out=root.parent/'measurements'/f'execa-control-{iteration}-{variant}.json'\n   cmd=['bun','apps/tui/scripts/tui.ts','perf','--workload','fresh','--workload','tail','--samples','1','--output',str(out)]\n   with out.with_suffix('.log').open('w') as log:subprocess.run(cmd,stdout=log,stderr=subprocess.STDOUT,check=True)\n   print(iteration,variant,[(s['workload'],round(s['readyMs'],1)) for s in json.loads(out.read_text())['summary']],flush=True)\nfinally:\n for p,s in saved.items():p.write_text(s)\n",
  "runtimeProbe": {
    "script": "import { mkdtemp, mkdir, writeFile, readFile, rm } from 'node:fs/promises'\nimport { tmpdir } from 'node:os'\nimport { join } from 'node:path'\nimport assert from 'node:assert/strict'\nimport { pathToFileURL } from 'node:url'\nconst { runProfilePnpm, viewProfilePackage } = await import(pathToFileURL(join(process.cwd(), 'packages/boot/plugin-manager/lib/types/operations.js')))\nconst root = await mkdtemp(join(tmpdir(), 'bake-package-probe-'))\ntry {\n const dir = join(root, 'profile'); await mkdir(dir)\n await writeFile(join(dir, 'package.json'), '{\"name\":\"fixture\",\"dsh\":{\"profile\":{\"bundles\":[]}}}')\n const script = join(root, 'child.mjs'); await writeFile(script, 'process.stdout.write(JSON.stringify({name:\"fixture\",version:\"1.0.0\"}))')\n const context = { profile:'fixture', dir, installAnchor:join(dir,'package.json'), cwd:root }\n const out = await runProfilePnpm(context, [], { command:process.execPath,args:[script],execution:'service',outputBytes:1024,activateNewBundles:false })\n assert.equal(out.exitCode,0);assert.equal(await readFile(out.logPath,'utf8'),out.output)\n const view = await viewProfilePackage(dir,'fixture',{command:process.execPath,args:[script],timeoutMs:3000})\n assert.equal(view.exitCode,0);assert.equal(JSON.parse(view.stdout).name,'fixture')\n const canceled = await runProfilePnpm(context, [], {command:process.execPath,args:[script],execution:'service',outputBytes:1024,activateNewBundles:false,signal:AbortSignal.abort()})\n assert.notEqual(canceled.exitCode,0)\n const inspectCanceled = await viewProfilePackage(dir,'fixture',{command:process.execPath,args:[script],timeoutMs:3000,signal:AbortSignal.abort()})\n assert.equal(inspectCanceled.exitCode,null)\n console.log(JSON.stringify({run:'passed',view:'passed',abortedRun:'passed',abortedView:'passed'}))\n} finally {await rm(root,{recursive:true,force:true})}\n",
    "result": {
