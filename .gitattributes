# The repo's canonical text form is LF, enforced at checkout too: no smudge
# boundary between working tree and repo, so byte-level gates (verify-*
# comparisons, blob hashing, coverage offsets) see one form on every host.
* text=auto eol=lf

*.pdf binary

# Third-party license files are upstream bytes; quickjs-ng's LICENSE has a line
# holding one space, so whitespace checks skip them.
crates/*/*/LICENSE-* -whitespace

# Fuzz seeds are exact input bytes: CRLF, control bytes, and missing final
# newlines are what they test, so Git never normalizes or whitespace-checks them.
fuzz/corpus/** binary
