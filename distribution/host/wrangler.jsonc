// The download service at https://bake.justar.dev: the Worker in worker.mjs,
// over the files stage-site.mjs stages into site/ before each deploy. The
// release workflow deploys it with `npm run deploy` from this directory;
// distribution/README.md describes the service and its secrets.
{
  "name": "bake-downloads",
  "account_id": "c8dbba40cfd4ed115775e568e4473843",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node stage-site.mjs"
  },
  // The Worker answers every request, so it alone decides what is served and
  // with which headers; the binding only reads the staged files.
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "routes": [
    { "pattern": "bake.justar.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "BAKE_ARCHIVE_REDIRECT": "https://github.com/Justar96/bake/releases/download"
  },
  "observability": {
    "enabled": true
  }
}
