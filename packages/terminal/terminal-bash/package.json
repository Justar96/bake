    "bake-session": "workspace:^",
    "bake-subprocess": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^"
  },
  "dependencies": {
    "bake-lazy-require": "workspace:^",
    "@deepseek-ai/dsh-pwsh-local": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "@xterm/headless": "catalog:"
  },
  "devDependencies": {
    "bake-agent": "workspace:^",
    "bake-agent-loop-testkit": "workspace:^",
    "@deepseek-ai/dsh-terminal": "workspace:^",
    "bake-sandbox": "workspace:^",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:^",
    "bake-session": "workspace:^",
    "bake-subprocess": "workspace:^",
    "@deepseek-ai/dsh-subprocess-local": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
