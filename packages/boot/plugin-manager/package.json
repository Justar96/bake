{
  "name": "@deepseek-ai/dsh-plugin-manager",
  "description": "Current-profile plugin and bundle management shared by dsh CLI, Web and agent tools",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bake.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-app-boot": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "execa": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:",
    "bake-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "bake-host-plugin-inventory": "workspace:^",
    "bake-subprocess": "workspace:^",
    "bake-typert-protocol": "workspace:^",
    "bake-tools": "workspace:^",
    "@deepseek-ai/dsh-hmr": "workspace:^",
    "bake-brand": "workspace:^",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:^",
    "bake-sandbox": "workspace:^",
    "@deepseek-ai/dsh-user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-hmr": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "bake-host-plugin-inventory": "workspace:^",
    "bake-subprocess": "workspace:^",
    "bake-typert-protocol": "workspace:^",
    "bake-tools": "workspace:^",
    "bake-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-hmr": "workspace:^",
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "bake-brand": "workspace:^",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:^",
    "bake-agent": "workspace:^",
    "bake-session": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "bake-sandbox": "workspace:^",
    "@deepseek-ai/dsh-user-approval": "workspace:^"
  }
}
