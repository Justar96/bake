{
  "name": "bake-headless",
  "description": "The dsh one-shot bundle: a direct core Agent/Session runner over bake-base with no Host, HTTP, or browser layer",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bake.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "bake-brand": "workspace:^",
    "bake-cmdline": "workspace:^",
    "bake-tool-subagent": "workspace:^",
    "bake-util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "commander": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "bake-agent": "workspace:^",
    "bake-agent-default-model": "workspace:^",
    "bake-llm": "workspace:^",
    "bake-session": "workspace:^",
    "bake-session-persistence": "workspace:^",
    "bake-session-query": "workspace:^",
    "bake-fs": "workspace:^",
    "bake-agent-loop": "workspace:^",
    "bake-jobs": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "bake-agent": "workspace:^",
    "bake-agent-default-model": "workspace:^",
    "bake-agent-loop": "workspace:^",
    "bake-agent-loop-testkit": "workspace:^",
    "bake-llm": "workspace:^",
    "bake-session": "workspace:^",
    "bake-session-persistence": "workspace:^",
    "bake-session-query": "workspace:^",
    "bake-fs": "workspace:^",
    "bake-jobs": "workspace:^"
  }
}
