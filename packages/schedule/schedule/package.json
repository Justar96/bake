{
  "name": "bake-schedule",
  "description": "Agent-scoped durable after, at, and fixed-rate reminders over the session event log",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bake.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "bake-agent": "workspace:^",
    "bake-brand": "workspace:^",
    "bake-invariants": "workspace:^",
    "bake-llm": "workspace:^",
    "bake-session": "workspace:^",
    "bake-session-persistence": "workspace:^",
    "bake-session-projection": "workspace:^",
    "bake-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "bake-agent": "workspace:^",
    "bake-agent-loop": "workspace:^",
    "bake-agent-loop-testkit": "workspace:^",
    "bake-brand": "workspace:^",
    "bake-invariants": "workspace:^",
    "bake-llm": "workspace:^",
    "bake-session": "workspace:^",
    "bake-session-persistence": "workspace:^",
    "bake-session-persistence-jsonl": "workspace:^",
    "bake-session-projection": "workspace:^",
    "bake-system-prompt": "workspace:^",
    "bake-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
