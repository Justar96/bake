    "bake-session": "workspace:^",
    "bake-session-projection": "workspace:^",
    "bake-compaction-image-offload": "workspace:^"
  },
  "dependencies": {
    "bake-util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "bake-compaction": "workspace:^",
    "bake-llm": "workspace:^",
    "bake-llm-retry": "workspace:^",
    "bake-session": "workspace:^",
    "bake-session-projection": "workspace:^",
    "bake-compaction-image-offload": "workspace:^"
  }
}
