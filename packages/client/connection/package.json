{
  "name": "bake-client-connection",
  "description": "Authenticated RPC transport and generation lifecycle",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bake.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "bake-credentials": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "catalog:"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "bake-attachment": "workspace:^",
    "bake-brand": "workspace:^",
    "bake-host-webserver": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "bake-session": "workspace:^"
  }
}
