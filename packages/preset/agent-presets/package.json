{
  "name": "bake-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the DeepSeek Harness",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bake.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "presets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "bake-agent": "workspace:^",
    "bake-atomic-write": "workspace:^",
    "bake-invariants": "workspace:^",
    "bake-home-paths": "workspace:^",
    "bake-scope": "workspace:^",
    "bake-session": "workspace:^",
    "bake-session-projection": "workspace:^",
    "bake-settings": "workspace:^",
    "bake-system-prompt": "workspace:^",
    "bake-tools": "workspace:^",
    "bake-typert-protocol": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "catalog:",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "bake-app-boot": "workspace:^",
    "@deepseek-ai/cordis-plugin-group": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "bake-agent": "workspace:^",
    "bake-agent-loop": "workspace:^",
    "bake-atomic-write": "workspace:^",
    "bake-invariants": "workspace:^",
    "bake-llm": "workspace:^",
    "bake-home-paths": "workspace:^",
    "bake-scope": "workspace:^",
    "bake-session": "workspace:^",
    "bake-session-projection": "workspace:^",
    "bake-settings": "workspace:^",
    "bake-settings-file": "workspace:^",
    "bake-system-prompt": "workspace:^",
    "bake-tools": "workspace:^",
    "bake-typert-protocol": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
