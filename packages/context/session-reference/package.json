{
  "name": "@deepseek-ai/dsh-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bake.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "bake-brand": "workspace:^",
    "bake-util-values": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "bake-agent": "workspace:^",
    "bake-compaction": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "bake-output-retention": "workspace:^",
    "bake-session": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-session-projection-cache": "workspace:^",
    "bake-session-query": "workspace:^",
    "@deepseek-ai/dsh-session-title": "workspace:^",
    "bake-spill": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "bake-system-prompt": "workspace:^",
    "bake-typert-protocol": "workspace:^"
  },
  "peerDependenciesMeta": {
    "bake-spill": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/cordis-plugin-include": "workspace:^",
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "bake-agent": "workspace:^",
    "bake-compaction": "workspace:^",
    "@deepseek-ai/dsh-fs-local": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "bake-output-retention": "workspace:^",
    "bake-session": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-session-projection-cache": "workspace:^",
    "bake-session-query": "workspace:^",
    "@deepseek-ai/dsh-session-query-sqlite": "workspace:^",
    "@deepseek-ai/dsh-session-title": "workspace:^",
    "bake-spill": "workspace:^",
    "@deepseek-ai/dsh-subagent": "workspace:^",
    "@deepseek-ai/dsh-spill-local": "workspace:^",
    "bake-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-tool-fs": "workspace:^",
    "bake-tools": "workspace:^",
    "bake-typert-protocol": "workspace:^"
  }
}
