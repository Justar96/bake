{
  "name": "bake-bash-sandbox",
  "description": "Sandbox-consuming implementation of the DeepSeek Harness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bake.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "bake-shell": "workspace:^",
    "bake-bash-local": "workspace:^",
    "bake-sandbox": "workspace:^",
    "bake-sandbox-policy": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "bake-shell": "workspace:^",
    "bake-bash-local": "workspace:^",
    "bake-subprocess-local": "workspace:^",
    "bake-sandbox": "workspace:^",
    "bake-sandbox-local": "workspace:^",
    "bake-sandbox-policy": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/node-addon-system": "workspace:^",
    "bake-session-projection": "workspace:^"
  }
}
