{
  "name": "bake-credentials-local",
  "description": "File-backed credentials provider ($DSH_HOME/.env under the live process environment) for the DeepSeek Harness",
  "version": "0.1.6-alpha.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justar96/bake.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "bake-atomic-write": "workspace:^",
    "bake-credentials": "workspace:^",
    "bake-launch-environment": "workspace:^",
    "bake-home-paths": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "catalog:",
    "@deepseek-ai/schemastery": "workspace:^",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "bake-atomic-write": "workspace:^",
    "bake-credentials": "workspace:^",
    "bake-launch-environment": "workspace:^",
    "bake-home-paths": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
