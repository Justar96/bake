  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "bake-compaction": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "bake-session": "workspace:^"
  },
  "dependencies": {
    "bake-session-format-catalog": "workspace:^",
    "bake-util-values": "workspace:^"
  }
