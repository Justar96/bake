{
  "name": "bake",
  "version": "0.1.8",
  "description": "A terminal coding agent built on Cordis and the DeepSeek Harness runtime",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2",
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "vendor/*",
    "packages/*/*",
    "native/system",
    "native/system/packages/*",
    "apps/cli",
    "apps/tui/packages/*"
  ],
  "catalog": {
    "@types/bun": "1.4.2",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@xterm/headless": "^6.0.0",
    "ajv": "^8.20.0",
    "chokidar": "^4.0.3",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "eventsource-parser": "^3.1.1",
    "execa": "^10.0.0",
    "ink": "^7.1.1",
    "js-yaml": "^4.2.0",
    "koffi": "^3.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "node-addon-require-builtin": "^0.1.6",
    "react": "^19.3.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "undici": "^8.10.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "patchedDependencies": {
    "node-pty@1.2.0-beta.15": "patches/node-pty@1.2.0-beta.15.patch",
    "ink@7.1.1": "patches/ink@7.1.1.patch"
  },
  "trustedDependencies": [
    "@deepseek-ai/dsh-subprocess-local",
    "esbuild",
    "koffi",
    "lefthook",
    "node-pty"
  ],
  "scripts": {
    "start": "bun apps/tui/scripts/tui.ts app",
    "dev": "bun apps/tui/scripts/tui.ts dev",
    "dev:tui": "bun run build && bun run start",
    "build": "bun run verify-workspace && bun run verify-tsconfig-paths && bun run build:runtime && bun run build:tui",
    "build:tui": "bun apps/tui/scripts/tui.ts build",
    "build:runtime": "bun run build:native-system && bun run build:lib:host",
    "build:native-system": "bun native/system/scripts/build.ts --host-addon-only",
    "build:lib:host": "bun node_modules/typescript/bin/tsc -b tsconfig.host.json && bun run --bun tsdown",
    "typecheck": "bun node_modules/typescript/bin/tsc -b tsconfig.host.json && bun apps/tui/scripts/tui.ts check types",
    "check": "bun run verify-workspace && bun run verify-tsconfig-paths && bun test scripts/workspace.test.ts && bun apps/tui/scripts/tui.ts check",
    "test": "bun apps/tui/scripts/tui.ts check unit spec",
    "test:runtime": "node node_modules/vitest/vitest.mjs run",
    "test:e2e": "bun apps/tui/scripts/tui.ts e2e",
    "verify": "bun scripts/preflight.ts --full",
    "release:pack": "bun scripts/release/pack.ts",
    "release:assemble": "bun scripts/release/assemble.ts",
    "release:verify-local": "bun scripts/release/verify-local.ts",
    "release:prepare": "bun scripts/release/prepare.ts",
    "release:preflight": "bun scripts/release/preflight.ts",
    "release:verify-live": "bun scripts/release/verify-live.ts",
    "lint": "bun scripts/run-oxlint.ts apps packages scripts --config .oxlintrc.staged.json",
    "preflight": "bun scripts/preflight.ts",
    "doc-sync": "bun apps/tui/scripts/tui.ts check docs",
    "gen-workspace": "bun scripts/gen-workspace.ts",
    "verify-workspace": "bun scripts/gen-workspace.ts --check",
    "gen-tsconfig-paths": "bun scripts/gen-tsconfig-paths.ts",
    "verify-tsconfig-paths": "bun scripts/gen-tsconfig-paths.ts --check",
    "gen-workflow-guest": "bun scripts/gen-workflow-guest.ts",
    "gen-session-format-catalog": "bun scripts/gen-session-format-catalog.ts",
    "gen-persistence-catalog": "bun scripts/gen-persistence-catalog.ts",
    "verify-persistence-catalog": "bun scripts/gen-persistence-catalog.ts --check",
    "gen-config-catalog": "bun scripts/gen-config-catalog.ts",
    "verify-config-catalog": "bun scripts/gen-config-catalog.ts --check",
    "gen-cordis-catalog": "bun scripts/gen-cordis-api.ts",
    "verify-cordis-catalog": "bun scripts/gen-cordis-api.ts --check",
    "gen-doc-graphs": "bun scripts/gen-doc-graphs.ts",
    "verify-doc-graphs": "bun scripts/gen-doc-graphs.ts --check",
    "gen-module-graph": "bun scripts/gen-module-graph.ts",
    "verify-module-graph": "bun scripts/gen-module-graph.ts --check",
    "gen-tool-catalog": "bun scripts/gen-tool-catalog.ts",
    "verify-tool-catalog": "bun scripts/gen-tool-catalog.ts --check",
    "verify-type-equiv": "bun scripts/verify-type-equiv.ts",
    "verify-translation-pairing": "bun scripts/verify-translation-pairing.ts",
    "verify-cordis-config": "bun scripts/verify-cordis-config.ts",
    "verify-package-invariants": "bun scripts/verify-package-invariants.ts",
    "dsh": "bun apps/tui/scripts/tui.ts dsh",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/bun": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint-plugin-sonarjs": "^4.1.0",
    "fast-check": "^4.8.0",
    "js-yaml": "catalog:",
    "lefthook": "^2.1.9",
    "mdast-util-from-markdown": "catalog:",
    "mdast-util-gfm": "catalog:",
    "micromark-extension-gfm": "catalog:",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tsdown": "^0.22.2",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
